#!/bin/bash
set -euo pipefail

show_package_version() {
  python - <<'PY'
from importlib import metadata

print(f"taurcode {metadata.version('taurcode')}")
PY
}

show_tool_versions() {
  show_package_version
  python --version
  python -m pip --version
  python -m black --version
  python -m ruff --version
  python -m coverage --version
  check_tool_versions
}

check_tool_versions() {
  python - <<'PY'
from importlib import metadata
from pathlib import Path
import sys

REQUIRED_TOOLS = ("black", "ruff")


def read_constraints(path: Path) -> dict[str, str]:
    constraints: dict[str, str] = {}
    for raw_line in path.read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#") or "==" not in line:
            continue
        name, version = line.split("==", 1)
        constraints[name.strip().lower()] = version.strip()
    return constraints


constraints = read_constraints(Path("constraints-dev.txt"))
errors: list[str] = []

for tool in REQUIRED_TOOLS:
    expected = constraints.get(tool)
    if expected is None:
        errors.append(f"{tool}: missing from constraints-dev.txt")
        continue
    try:
        actual = metadata.version(tool)
    except metadata.PackageNotFoundError:
        errors.append(f"{tool}: not installed; expected {expected}")
        continue
    if actual != expected:
        errors.append(f"{tool}: expected {expected}, found {actual}")

if errors:
    print("ERROR: development toolchain mismatch:", file=sys.stderr)
    for error in errors:
        print(f"- {error}", file=sys.stderr)
    print(
        'Run: python -m pip install -e ".[dev]" -c constraints-dev.txt',
        file=sys.stderr,
    )
    raise SystemExit(1)
PY
}

verify_release() {
  local tag="${1:?Usage: scripts/version verify <tag>}"

  if [[ ! "$tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "ERROR: unsupported release tag format: $tag" >&2
    echo "Expected: vMAJOR.MINOR.PATCH (for example, v0.1.0)." >&2
    exit 1
  fi

  if [[ -n "$(git status --porcelain)" ]]; then
    echo "ERROR: working tree must be clean before release verification" >&2
    exit 1
  fi

  echo "Running: scripts/lint"
  scripts/lint
  echo "Running: scripts/format --check"
  scripts/format --check
  echo "Running: scripts/test"
  scripts/test
}

case "${1:-}" in
  "")
    show_package_version
    ;;
  tools)
    show_tool_versions
    ;;
  check-tools)
    check_tool_versions
    ;;
  verify)
    verify_release "${2:-}"
    ;;
  *)
    echo "Usage: scripts/version [tools|check-tools|verify <tag>]" >&2
    exit 2
    ;;
esac
